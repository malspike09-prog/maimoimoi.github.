<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>THPTQG Focus & Habit Tracker Pro</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700;800&display=swap');
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    .mono { font-family: 'JetBrains Mono', monospace; }
    .schulte-cell { transition: transform 0.1s ease, background-color 0.15s ease; user-select: none; -webkit-tap-highlight-color: transparent; }
    .schulte-cell:active { transform: scale(0.92); }
    
    /* Vòng tròn 080 BDM mở rộng thị giác ngoại vi */
    .bdm-overlay {
      position: absolute;
      inset: -10px;
      border: 2px dashed rgba(56, 189, 248, 0.55);
      border-radius: 1.25rem;
      pointer-events: none;
      animation: pulseBdm 3.6s infinite ease-in-out;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 8px;
    }
    @keyframes pulseBdm {
      0%, 100% { transform: scale(0.99); opacity: 0.35; }
      50% { transform: scale(1.025); opacity: 0.85; }
    }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #090d16; }
    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen pb-16 selection:bg-blue-600 selection:text-white">

  <!-- HEADER: ĐẾM NGƯỢC & SAO LƯU -->
  <header class="border-b border-slate-800/80 bg-slate-900/80 backdrop-blur-md sticky top-0 z-30 px-4 py-3">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-emerald-500 flex items-center justify-center shadow-lg shadow-blue-500/20">
          <i class="fa-solid fa-graduation-cap text-lg text-white"></i>
        </div>
        <div>
          <h1 class="text-base md:text-lg font-extrabold tracking-tight text-white flex items-center gap-2">
            THPTQG TRACKER
            <span class="text-[10px] bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 px-2 py-0.5 rounded-full uppercase mono">Full v2.5</span>
          </h1>
          <p class="text-xs text-slate-400" id="quoteText">"Kỷ luật là cầu nối giữa mục tiêu và thành tựu."</p>
        </div>
      </div>

      <!-- Bộ đếm ngược ngày thi -->
      <div class="flex items-center gap-3 bg-slate-950/90 px-3.5 py-2 rounded-xl border border-slate-800">
        <div class="text-xs font-semibold text-slate-400 flex items-center gap-1.5">
          <i class="fa-regular fa-calendar-check text-amber-400"></i>
          <span>Đếm ngược:</span>
        </div>
        <div class="flex items-baseline gap-1.5 mono font-bold text-amber-400 text-sm md:text-base">
          <span id="cdDays">000</span><span class="text-[10px] text-slate-400 font-normal">ngày</span>
          <span id="cdHours">00</span><span class="text-[10px] text-slate-400 font-normal">giờ</span>
          <span id="cdMins">00</span><span class="text-[10px] text-slate-400 font-normal">phút</span>
          <span id="cdSecs">00</span><span class="text-[10px] text-slate-400 font-normal">giây</span>
        </div>
        <button onclick="changeExamDatePrompt()" class="text-slate-500 hover:text-slate-300 text-xs ml-1" title="Chỉnh ngày thi">
          <i class="fa-solid fa-gear"></i>
        </button>
      </div>

      <!-- Sao lưu & Khôi phục JSON -->
      <div class="flex items-center gap-2 text-xs">
        <button onclick="exportData()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg border border-slate-700 transition flex items-center gap-1.5">
          <i class="fa-solid fa-download text-blue-400"></i> Sao lưu
        </button>
        <button onclick="document.getElementById('importFile').click()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg border border-slate-700 transition flex items-center gap-1.5">
          <i class="fa-solid fa-upload text-emerald-400"></i> Khôi phục
        </button>
        <input type="file" id="importFile" class="hidden" accept=".json" onchange="importData(event)">
      </div>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-4 py-6 space-y-6">

    <!-- PHẦN 1: POMODORO 3 CẤP ĐỘ & SCHULTE BOARD -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

      <!-- KHỐI POMODORO (5/12 cột) -->
      <section class="lg:col-span-5 bg-slate-900/70 border border-slate-800 rounded-2xl p-5 shadow-xl flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-sm font-bold tracking-wide uppercase text-slate-200 flex items-center gap-2">
              <i class="fa-solid fa-stopwatch text-blue-400"></i> Pomodoro Chống Tắt Ngầm
            </h2>
            <div class="flex items-center gap-1.5">
              <span id="audioKeepAliveBadge" class="text-[10px] px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 border border-slate-700 flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-slate-500" id="audioDot"></span> Audio Ngầm
              </span>
              <button id="wakeLockBtn" onclick="toggleWakeLock()" class="text-[11px] px-2 py-0.5 rounded-full border border-slate-700 bg-slate-800 text-slate-400 hover:text-white transition" title="Giữ màn hình không tắt">
                <i class="fa-solid fa-sun"></i> Giữ sáng: Tắt
              </button>
            </div>
          </div>

          <!-- 3 Cấp độ Pomodoro -->
          <div class="grid grid-cols-3 gap-2 mb-5">
            <button onclick="selectPomoLevel(1)" id="pomoLvl1" class="py-2.5 px-2 text-center rounded-xl text-xs font-bold border transition bg-blue-600 border-blue-500 text-white shadow-lg shadow-blue-600/20">
              Cấp 1: 25p<br><span class="text-[10px] font-normal opacity-85">Nghỉ 5p</span>
            </button>
            <button onclick="selectPomoLevel(2)" id="pomoLvl2" class="py-2.5 px-2 text-center rounded-xl text-xs font-bold border transition bg-slate-800/80 border-slate-700 text-slate-300 hover:bg-slate-800">
              Cấp 2: 60p<br><span class="text-[10px] font-normal opacity-85">Nghỉ 10p</span>
            </button>
            <button onclick="selectPomoLevel(3)" id="pomoLvl3" class="py-2.5 px-2 text-center rounded-xl text-xs font-bold border transition bg-slate-800/80 border-slate-700 text-slate-300 hover:bg-slate-800">
              Cấp 3: 90p<br><span class="text-[10px] font-normal opacity-85">Nghỉ 15p</span>
            </button>
          </div>

          <!-- Đồng hồ hiển thị -->
          <div class="relative bg-slate-950 border border-slate-800/90 rounded-2xl p-6 text-center mb-5 overflow-hidden">
            <div class="text-xs font-semibold uppercase tracking-widest mb-1 text-blue-400" id="pomoPhaseLabel">
              PHIÊN HỌC TẬP TRUNG
            </div>
            <div class="text-5xl md:text-6xl font-extrabold mono tracking-tight text-white my-2" id="pomoTimeDisplay">
              25:00
            </div>
            <!-- Thanh tiến trình -->
            <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden mt-4">
              <div id="pomoProgressBar" class="bg-gradient-to-r from-blue-500 to-emerald-400 h-full w-0 transition-all duration-300"></div>
            </div>
            <div class="flex justify-between text-[11px] text-slate-400 mt-2">
              <span>Đã học hôm nay: <strong class="text-emerald-400 mono" id="todayStudyMins">0</strong> phút</span>
              <span>Chu kỳ: <strong class="text-blue-400 mono" id="pomoCycleCount">0</strong></span>
            </div>
          </div>
        </div>

        <!-- Nút điều khiển Pomodoro -->
        <div class="space-y-2.5">
          <div class="grid grid-cols-4 gap-2">
            <button onclick="togglePomo()" id="pomoStartBtn" class="col-span-2 py-3 rounded-xl font-bold text-sm bg-emerald-600 hover:bg-emerald-500 text-white shadow-lg shadow-emerald-600/20 transition flex items-center justify-center gap-2">
              <i class="fa-solid fa-play" id="pomoStartIcon"></i> <span id="pomoStartText">Bắt đầu</span>
            </button>
            <button onclick="resetPomo()" class="py-3 rounded-xl font-semibold text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition flex items-center justify-center gap-1.5">
              <i class="fa-solid fa-rotate-right"></i> Đặt lại
            </button>
            <button onclick="skipPomoPhase()" class="py-3 rounded-xl font-semibold text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition flex items-center justify-center gap-1.5" title="Chuyển sang Nghỉ / Học">
              <i class="fa-solid fa-forward-step"></i> Chuyển
            </button>
          </div>
          <div class="flex items-center justify-between bg-slate-950/70 px-3 py-2 rounded-xl border border-slate-800/80 text-xs">
            <span class="text-slate-400"><i class="fa-solid fa-volume-high text-amber-400 mr-1"></i> Chuông báo trường thi (Cực to)</span>
            <button onclick="playLoudBell(1.2)" class="px-2.5 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/30 font-semibold transition">
              Thử chuông
            </button>
          </div>
        </div>
      </section>

      <!-- KHỐI SCHULTE BOARD (7/12 cột) -->
      <section class="lg:col-span-7 bg-slate-900/70 border border-slate-800 rounded-2xl p-5 shadow-xl flex flex-col justify-between">
        <div>
          <!-- Thanh công cụ Schulte -->
          <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
            <h2 class="text-sm font-bold tracking-wide uppercase text-slate-200 flex items-center gap-2">
              <i class="fa-solid fa-table-cells text-emerald-400"></i> Bảng Schulte & 080 BDM
            </h2>

            <!-- Chọn Cấp độ 3x3 -> 7x7 -->
            <div class="flex items-center bg-slate-950 p-1 rounded-xl border border-slate-800 text-xs font-bold mono">
              <button onclick="setSchulteSize(3)" id="szBtn3" class="px-2.5 py-1 rounded-lg text-slate-400 hover:text-white transition">3x3</button>
              <button onclick="setSchulteSize(4)" id="szBtn4" class="px-2.5 py-1 rounded-lg text-slate-400 hover:text-white transition">4x4</button>
              <button onclick="setSchulteSize(5)" id="szBtn5" class="px-2.5 py-1 rounded-lg bg-blue-600 text-white transition">5x5</button>
              <button onclick="setSchulteSize(6)" id="szBtn6" class="px-2.5 py-1 rounded-lg text-slate-400 hover:text-white transition">6x6</button>
              <button onclick="setSchulteSize(7)" id="szBtn7" class="px-2.5 py-1 rounded-lg text-slate-400 hover:text-white transition">7x7</button>
            </div>
          </div>

          <!-- Chọn Chế độ: Thường, Xáo, Gorbov + Focus Point + 080 BDM -->
          <div class="grid grid-cols-2 sm:grid-cols-5 gap-2 mb-4 text-xs">
            <button onclick="setSchulteMode('normal')" id="modeNormal" class="py-2 px-2 rounded-xl font-semibold border bg-emerald-600/20 border-emerald-500 text-emerald-300 transition">
              1. Thường
            </button>
            <button onclick="setSchulteMode('shuffle')" id="modeShuffle" class="py-2 px-2 rounded-xl font-semibold border bg-slate-800 border-slate-700 text-slate-300 transition">
              2. Xáo Số
            </button>
            <button onclick="setSchulteMode('gorbov')" id="modeGorbov" class="py-2 px-2 rounded-xl font-semibold border bg-slate-800 border-slate-700 text-slate-300 transition" title="Đen tăng dần xen kẽ Đỏ giảm dần">
              3. Gorbov
            </button>
            <button onclick="toggleFocusPoint()" id="focusPointBtn" class="py-2 px-2 rounded-xl font-semibold border bg-rose-500/20 border-rose-500/50 text-rose-300 transition flex items-center justify-center gap-1">
              <i class="fa-solid fa-bullseye"></i> Tâm Đỏ: Bật
            </button>
            <button onclick="toggleBdm()" id="bdmBtn" class="py-2 px-2 rounded-xl font-semibold border bg-sky-500/20 border-sky-500/50 text-sky-300 transition flex items-center justify-center gap-1">
              <i class="fa-solid fa-eye"></i> 080 BDM: Bật
            </button>
          </div>

          <!-- Thanh trạng thái Mục tiêu tiếp theo & Thời gian -->
          <div class="grid grid-cols-4 gap-2 bg-slate-950 p-3 rounded-xl border border-slate-800 mb-4 text-center">
            <div>
              <div class="text-[10px] text-slate-400 uppercase">Tìm ô tiếp theo</div>
              <div class="text-base font-extrabold mono mt-0.5 text-amber-400" id="schulteNextTarget">1</div>
            </div>
            <div>
              <div class="text-[10px] text-slate-400 uppercase">Thời gian</div>
              <div class="text-base font-extrabold mono mt-0.5 text-white" id="schulteTime">0.00s</div>
            </div>
            <div>
              <div class="text-[10px] text-slate-400 uppercase">Lỗi bấm sai</div>
              <div class="text-base font-extrabold mono mt-0.5 text-rose-400" id="schulteErrors">0</div>
            </div>
            <div>
              <div class="text-[10px] text-slate-400 uppercase">Kỷ lục</div>
              <div class="text-base font-extrabold mono mt-0.5 text-emerald-400" id="schulteBest">--</div>
            </div>
          </div>

          <!-- Khu vực Bảng Schulte -->
          <div class="relative mx-auto max-w-[380px] aspect-square flex items-center justify-center my-2">
            <!-- Khung 080 BDM
